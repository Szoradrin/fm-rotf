{"_id":"XardorokSunblght","name":"Xardorok Sunblight","type":"npc","img":"modules/rotf/assets/images/token-xardorok-sunblight.webp","system":{"abilities":{"str":{"value":16,"proficient":0},"dex":{"value":11,"proficient":0},"con":{"value":18,"proficient":0},"int":{"value":12,"proficient":0},"wis":{"value":13,"proficient":1},"cha":{"value":18,"proficient":1}},"attributes":{"ac":{"flat":16,"calc":"flat","formula":""},"hp":{"value":93,"max":93,"temp":0,"formula":"11d8+44"},"movement":{"units":"ft","hover":false,"ignoredDifficultTerrain":[],"walk":"25","burrow":"","climb":"","fly":"","swim":"","bonus":"","special":""},"senses":{"ranges":{"darkvision":120,"blindsight":null,"tremorsense":null,"truesight":null},"units":"ft","special":""}},"details":{"biography":{"value":"<p>Duergar warlord of Sunblight. AC 16 (chain mail). His crown and spiked gauntlet are chardalyn; the gauntlet opens the treasure vault (X36). Believes his patron is Deep Duerra; it is actually Asmodeus.</p><p><strong>Location (d20):</strong> 1-5 throne X19, 6-10 forge X24, 11-15 temple X29, 16-20 torture chamber X34. When losing he flees toward Grandolpha in X8; in the forge he makes his last stand in the temple.</p>","public":""},"alignment":"Lawful Evil","race":"","type":{"value":"humanoid","subtype":"Dwarf","swarm":"","custom":""},"cr":5},"source":{"revision":1,"rules":"2024","book":"","page":"","custom":"ROTF","license":""},"traits":{"size":"med","dr":{"value":["poison"],"bypasses":[],"custom":""},"di":{"value":[],"bypasses":[],"custom":""},"ci":{"value":[],"custom":""},"languages":{"value":[],"custom":"Common, Dwarvish","communication":{}}},"skills":{"arc":{"value":1,"ability":"int"},"dec":{"value":1,"ability":"cha"},"itm":{"value":1,"ability":"cha"}}},"items":[{"name":"Duergar Resilience","type":"feat","img":"icons/magic/defensive/shield-barrier-glowing-triangle-blue.webp","system":{"description":{"value":"<p>Advantage on saving throws against poison, spells, and illusions, and to resist being Charmed or Paralyzed.</p>","chat":""},"type":{"value":"monster","subtype":""},"activities":{},"uses":{"spent":0,"max":"","recovery":[]},"properties":["trait"],"source":{"rules":"2024"}},"_id":"XardorokSunb0001","sort":100000,"_key":"!actors.items!XardorokSunblght.XardorokSunb0001"},{"name":"Innate Spellcasting","type":"feat","img":"icons/magic/symbols/runes-star-pentagon-orange.webp","system":{"description":{"value":"<p>Charisma (spell save DC 15, +7 to hit with spell attacks), no material components. At will: eldritch blast, mage hand. 1/day each: hold person, suggestion.</p>","chat":""},"type":{"value":"monster","subtype":""},"activities":{},"uses":{"spent":0,"max":"","recovery":[]},"properties":["trait"],"source":{"rules":"2024"}},"_id":"XardorokSunb0002","sort":200000,"_key":"!actors.items!XardorokSunblght.XardorokSunb0002"},{"name":"Sunlight Sensitivity","type":"feat","img":"icons/magic/light/explosion-star-glow-yellow.webp","system":{"description":{"value":"<p>While in sunlight, Xardorok has disadvantage on attack rolls and on Wisdom (Perception) checks that rely on sight.</p>","chat":""},"type":{"value":"monster","subtype":""},"activities":{},"uses":{"spent":0,"max":"","recovery":[]},"properties":["trait"],"source":{"rules":"2024"}},"_id":"XardorokSunb0003","sort":300000,"_key":"!actors.items!XardorokSunblght.XardorokSunb0003"},{"name":"Psychic Conquest (Temple X29 only)","type":"feat","img":"icons/magic/control/hypnosis-target-eyes-pink.webp","system":{"description":{"value":"<p>While in Deep Duerra's temple (X29), Xardorok deals an extra 5 (1d10) psychic damage with weapon hits and regains hit points equal to that psychic damage. Lost if the statue's flame is extinguished (an action).</p>","chat":""},"type":{"value":"monster","subtype":""},"activities":{},"uses":{"spent":0,"max":"","recovery":[]},"properties":["trait"],"source":{"rules":"2024"}},"_id":"XardorokSunb0004","sort":400000,"_key":"!actors.items!XardorokSunblght.XardorokSunb0004"},{"name":"Multiattack",